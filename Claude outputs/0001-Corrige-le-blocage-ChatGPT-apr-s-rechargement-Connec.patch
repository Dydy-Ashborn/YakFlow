MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- YakFlow : pas de rechargement auto de l'onglet ChatGPT pendant une image en cours
- Connect : jamais de rechargement pendant une image en cours/en retard/en récupération
- Connect : mémorise la conversation de chaque image et y retourne après un rechargement
- Connect : libère la file au bout de 2 min si la conversation est perdue ; YakFlow relance l'image une fois

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NQC17D5SzSVqBKQqwHBdeD
---
 public/studio.html             |  4 +++-
 public/yakflow-connect.user.js | 25 +++++++++++++++++++++----
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/public/studio.html b/public/studio.html
index 74d312d..a5ff677 100644
--- a/public/studio.html
+++ b/public/studio.html
@@ -1736,6 +1736,8 @@ async function genChatGPT(p, s) {
     if (st.st === 'echec' || st.st === 'incertain') {
       // Pas de purge implicite : un résultat en retard doit rester récupérable.
       // Le nettoyage est réservé à l'ACK après enregistrement définitif.
+      // YAKFLOW_CONV_URL_V1 : conversation perdue → relance unique (aucune image n'existe à livrer)
+      if (st.st === 'incertain' && /conversation perdue/i.test(st.error || '') && (s.img.tries || 0) < 2) { await bridge('POST', 'forget?id=' + encodeURIComponent(id)).catch(() => {}); return { notSent: true, err: 'Conversation ChatGPT perdue : image relancée une fois' }; }
       if (st.st === 'incertain') return { err: st.error, noRetry: true };
       if (/limite|limit|quota|pièces jointes/i.test(st.error || '')) return { err: 'Quota ChatGPT : ' + st.error, noRetry: true };
       return { err: 'ChatGPT : ' + st.error };
@@ -2657,7 +2659,7 @@ async function tick() {
       // alerte si rien n'avance pendant 45 min (hors file pleine)
       const stuck = now() - lastProgress > 45 * 60000 && !projects.some((p) => p.etapes.some((s) => s.clip.st === 'file' || s.img.st === 'file'));
       // YAKFLOW_CHAT_HEAL_V1 : rien n'avance depuis 20 min alors que des images ChatGPT attendent → on recharge les onglets ChatGPT
-      if (S.imgSrc === 'chatgpt' && now() - lastProgress > 20 * 60000 && now() - lastChatHeal > 25 * 60000 && chatPauseUntil < now() &&
+      if (S.imgSrc === 'chatgpt' && now() - lastProgress > 20 * 60000 && now() - lastChatHeal > 25 * 60000 && chatPauseUntil < now() && (!chatAlive || chatInFlight === 0) &&
           projects.some((p) => p.actif && p.etapes.some((s) => s.promptImage && ['attente', 'calcul'].includes(s.img.st)))) {
         lastChatHeal = now(); bridge('POST', 'reload').then(() => log('Aucune image depuis 20 min : je recharge les onglets ChatGPT.')).catch(() => {});
       }
