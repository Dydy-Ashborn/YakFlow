+        if (j.url && location.pathname !== j.url && (j.navTries || 0) < 2) {
+          j.navTries = (j.navTries || 0) + 1;
+          try { sessionStorage.setItem(ACTIVE_KEY, JSON.stringify(j)); } catch (_) {}
